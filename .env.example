# 当前运行环境：dev / test / prod，决定加载哪个 .env.{APP_ENV} 文件
APP_ENV="dev"
# Node.js 运行模式：development / test / production，由 APP_ENV 自动映射
NODE_ENV="development"
# PostgreSQL 数据库连接字符串（Prisma 通过 prisma.config.ts 读取此变量）
DATABASE_URL="postgresql://username:password@localhost:5432/mydb?schema=public"
# JWT 签名密钥（Access Token 使用，建议长度 ≥ 32 字符）
JWT_SECRET="your-jwt-secret-at-least-32-characters-long"
# JWT Refresh Token 签名密钥（若使用 JWT 格式的 Refresh Token，当前未使用）
JWT_REFRESH_SECRET="your-refresh-secret-at-least-32-characters-long"
# HTTP 服务监听端口
PORT="4399"
